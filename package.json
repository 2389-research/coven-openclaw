{
  "name": "@2389research/coven-openclaw",
  "version": "0.1.3",
  "description": "Coven Gateway channel plugin for OpenClaw",
  "type": "module",
  "files": [
    "src/",
    "proto/",
    "index.ts",
    "openclaw.plugin.json",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "channel": {
      "id": "coven",
      "label": "Coven Gateway",
      "selectionLabel": "Coven Gateway (gRPC)",
      "docsPath": "/channels/coven",
      "order": 90
    },
    "install": {
      "npmSpec": "@2389research/coven-openclaw",
      "defaultChoice": "npm"
    }
  }
}
